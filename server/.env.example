# API runtime settings: keep this file as a template and put secrets in your ignored .env file.
NODE_ENV=development
PORT=4000
# Paste your Atlas Connect > Drivers URI here, with a database user and URL-encoded password.
# Allow your current IP in Atlas Network Access. Docker is not required.
MONGO_URI=mongodb+srv://YOUR_USER:YOUR_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/projectflow?retryWrites=true&w=majority
# Replace this placeholder with a long random value before exposing the API.
JWT_SECRET=replace-with-a-long-random-secret-before-running
JWT_EXPIRES_IN=1d
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
